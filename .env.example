# 푸른나무 심리센터 환경변수
# 로컬 개발 시 .env 또는 .env.local 로 복사. 프로덕션은 Vercel 프로젝트 환경변수에 등록.

# ─────────────────────────────────────────────────────────────
# 데이터베이스 (Vercel Postgres / Neon / 호환 PG)
# ─────────────────────────────────────────────────────────────
# Vercel Postgres 를 프로젝트에 연결하면 자동으로 주입됩니다:
#   POSTGRES_URL                — 풀링 일반
#   POSTGRES_PRISMA_URL         — Prisma 런타임 (pgbouncer 모드)
#   POSTGRES_URL_NON_POOLING    — Prisma migrate / db push 용 직접 연결
# `vercel env pull .env` 로 동기화하세요.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# ─────────────────────────────────────────────────────────────
# AI - Google Gemini (gemini-2.5-flash)
# ─────────────────────────────────────────────────────────────
# 챗봇 + 게시판 자동 모더레이션을 이 키 하나로 처리.
# 비워두면 챗봇은 안내 문구만 출력하고, 모더레이션은 모든 글 PASS 처리.
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# 관리자 콘솔
# ─────────────────────────────────────────────────────────────
# 관리자(소장님) 로그인 세션 서명용 시크릿. 운영 시 반드시 32자 이상 강력한 랜덤 문자열로 교체.
ADMIN_SESSION_SECRET="please-change-this-in-production-please-change-this-32chars-min"

# 최초 관리자 계정 시드용 (npm run seed:admin 실행 시 사용)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme1234"
