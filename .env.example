# 푸른나무 심리센터 환경변수
# 이 파일을 .env 또는 .env.local 로 복사하여 실제 값으로 채우세요.

# 데이터베이스 (SQLite, 기본값 사용)
DATABASE_URL="file:./dev.db"

# AI 챗봇 (Claude Sonnet) - 비워두면 챗봇은 안내 문구만 출력
ANTHROPIC_API_KEY=

# 게시판 자동 모더레이션 (GPT-4.1-nano) - 비워두면 모든 글이 PASS 처리
OPENAI_API_KEY=

# 관리자(소장님) 로그인 세션 서명용 시크릿. 운영 시 반드시 강력한 랜덤 문자열로 교체.
ADMIN_SESSION_SECRET="please-change-this-in-production-please-change-this-32chars-min"

# 최초 관리자 계정 시드용 (npm run seed:admin 실행 시 사용)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme1234"
